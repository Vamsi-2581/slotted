---
import { getCollection, render } from 'astro:content';

import Example from '../../../components/Example.astro';
import FrameworkCode from '../../../components/FrameworkCode.astro';
import Docs from '../../../layouts/Docs.astro';
import { familyCatalog } from '../../../lib/catalog';
import { FRAMEWORK_LABELS, FRAMEWORKS, type Framework } from '../../../runtime/frameworks';

export async function getStaticPaths() {
  const entries = await getCollection('components');
  return FRAMEWORKS.flatMap((framework) =>
    entries.map((entry) => ({ params: { framework, family: entry.id }, props: { entry } })),
  );
}

const { entry } = Astro.props;
const framework = Astro.params.framework as Framework;
const { Content, headings } = await render(entry);
/* The untitled region above the first section is a section too: the title names it. */
const toc = [
  { id: 'overview', label: 'Overview' },
  ...headings
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ id: heading.slug, label: heading.text })),
];

const frameworkHrefs = {
  react: `/react/components/${entry.id}/`,
  angular: (FRAMEWORKS as readonly string[]).includes('angular')
    ? `/angular/components/${entry.id}/`
    : null,
};
---

<Docs
  title={`${entry.data.title} — ${FRAMEWORK_LABELS[framework]}`}
  description={entry.data.description}
  framework={framework}
  frameworkHrefs={frameworkHrefs}
  toc={toc}
  markdownHref={`/${framework}/components/${entry.id}.md`}
>
  <nav class="docs-crumbs" aria-label="Breadcrumb">
    <a href={`/${framework}/components/${entry.id}/`}>Components</a>
    <span aria-hidden="true">/</span>
    <span>{familyCatalog(entry.id).group}</span>
  </nav>
  <h1 id="overview">{entry.data.title}</h1>
  <p class="docs-lead">{entry.data.description}</p>
  <div class="docs-prose">
    <Content components={{ Example, FrameworkCode }} />
  </div>
</Docs>
