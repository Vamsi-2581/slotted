{
  "name": "slotted",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "turbo run build --filter @slotted/theme --filter @slotted/themes",
    "build:core": "turbo run build --filter @slotted/core",
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter @slotted/storybook-react",
    "dev:angular": "turbo run dev --filter @slotted/storybook-angular",
    "format": "prettier --write .",
    "generate:glyphs": "node scripts/generate-icon-glyphs.mjs",
    "format:check": "prettier --check .",
    "pack:beta": "pnpm build && node scripts/pack-beta.mjs",
    "release:beta": "node scripts/pack-beta.mjs --bump && pnpm pack:beta",
    "demo:refresh": "turbo run build --filter @slotted/angular --filter @slotted/core --filter @slotted/themes && node scripts/pack-beta.mjs --only @slotted/angular,@slotted/core,@slotted/themes && pnpm install",
    "demo:nexora": "pnpm demo:refresh && pnpm --filter @slotted/demo-nexora-angular start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --build tsconfig.json --pretty false",
    "test:contracts": "node --test specs/*.test.mjs specs/components/*/*.test.mjs",
    "test:package-layers": "node --test scripts/verify-package-layers.test.mjs && node scripts/verify-package-layers.mjs",
    "test:release": "node --test scripts/pack-beta.test.mjs",
    "test:docs": "node --test scripts/verify-docs-snippets.test.mjs scripts/verify-token-foundation.test.mjs scripts/verify-typecheck-projects.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:contracts && pnpm test:package-layers && pnpm test:release && pnpm test:docs",
    "check:affected": "pnpm check && turbo run verify --affected",
    "check:full": "pnpm check && turbo run verify"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "lucide": "1.24.0",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
