{
  "name": "@slotted/theme",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "cli",
    "conformance",
    "scripts/build-theme-cli.mjs"
  ],
  "bin": {
    "slotted-build-theme": "./scripts/build-theme-cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layer-order": {
      "types": "./dist/types/layer-order.d.ts",
      "import": "./dist/layer-order.js"
    },
    "./contract.json": "./src/contract.json",
    "./contract": "./src/contract.mjs",
    "./render-theme": "./src/render-theme.mjs",
    "./theme-conformance": "./src/theme-conformance.mjs",
    "./conformance": "./conformance/theme-conformance.mjs",
    "./tone-hover": "./src/tone-hover.mjs",
    "./validate-theme": "./src/validate-theme.mjs",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "generate": "node scripts/generate-sources.mjs",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/write-styles.mjs",
    "test": "vitest run && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "verify": "pnpm build && pnpm test && pnpm typecheck"
  },
  "dependencies": {
    "lightningcss": "1.33.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
