{
  "schemaVersion": 5,
  "family": "alert",
  "ui": "alert",
  "catalog": {
    "group": "Feedback",
    "summary": "Framed notice heading a section, a form or a page."
  },
  "axes": {
    "tone": ["accent", "secondary", "info", "success", "warning", "danger"],
    "variant": ["soft", "outline", "solid"],
    "reach": ["inline", "section", "page"],
    "live": ["off", "polite", "assertive"]
  },
  "toneGlyphs": {
    "accent": "status-info",
    "secondary": null,
    "info": "status-info",
    "success": "status-success",
    "warning": "status-warning",
    "danger": "status-danger"
  },
  "liveRoles": {
    "off": null,
    "polite": "status",
    "assertive": "alert"
  },
  "stateAttributes": {
    "open": "data-open"
  },
  "stateModel": {
    "open": {
      "controlled": "open",
      "uncontrolled": "defaultOpen",
      "request": "onOpenChange",
      "reasons": ["dismiss", "programmatic"]
    }
  },
  "messages": ["dismiss"],
  "members": {
    "alert": {
      "nativeElement": "section",
      "defaults": {
        "tone": "accent",
        "variant": "soft",
        "reach": "section",
        "live": "off",
        "hideIcon": false,
        "dismissible": false,
        "defaultOpen": true,
        "restoreFocus": true
      },
      "capabilities": ["appearance", "live", "open"],
      "states": ["default", "hover", "active", "focus-visible", "open"],
      "parts": ["root", "icon", "content", "title", "description", "actions", "dismiss"]
    }
  },
  "scenarios": {
    "alert": [
      "playground",
      "tones",
      "variants",
      "reach",
      "dismissal",
      "actions",
      "live",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
