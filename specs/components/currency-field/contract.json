{
  "schemaVersion": 5,
  "family": "currency-field",
  "ui": "currency-field",
  "controlPart": "input",
  "controlRole": "spinbutton",
  "rootRole": null,
  "inputType": "text",
  "hiddenValueInput": true,
  "valueType": "number | null",
  "valueUnit": "major",
  "core": ["@slotted/core/currency", "@slotted/core/number"],
  "stateSource": "field",
  "mirrorsState": true,
  "requiredAttribute": "aria-required",
  "disabledAttribute": "disabled",
  "wiring": {
    "id": "always",
    "aria-describedby": "merged",
    "aria-invalid": "invalid",
    "aria-required": "required",
    "disabled": "disabled",
    "readonly": "readOnly"
  },
  "ariaValue": ["aria-valuenow", "aria-valuemin", "aria-valuemax", "aria-valuetext"],
  "keyboard": [
    {
      "key": "ArrowUp",
      "effect": "step",
      "by": "step"
    },
    {
      "key": "ArrowDown",
      "effect": "step",
      "by": "step"
    },
    {
      "key": "Shift+ArrowUp",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Shift+ArrowDown",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Alt+ArrowUp",
      "effect": "step",
      "by": "smallStep"
    },
    {
      "key": "Alt+ArrowDown",
      "effect": "step",
      "by": "smallStep"
    },
    {
      "key": "PageUp",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "PageDown",
      "effect": "step",
      "by": "largeStep"
    },
    {
      "key": "Home",
      "effect": "min"
    },
    {
      "key": "End",
      "effect": "max"
    },
    {
      "key": "Enter",
      "effect": "commit"
    },
    {
      "key": "-",
      "effect": "sign",
      "sign": "negative"
    },
    {
      "key": "+",
      "effect": "sign",
      "sign": "positive"
    }
  ],
  "escapeBound": false,
  "enterSubmits": true,
  "stepperTabIndex": -1,
  "stepperNames": ["incrementLabel", "decrementLabel"],
  "stepperDisabledAtBound": true,
  "parseOn": "input",
  "commitOn": ["blur", "enter", "step", "wheel"],
  "entryModel": {
    "cents": {
      "digitsAre": "the value",
      "shiftBy": "minorUnits",
      "writesTextOn": "input",
      "caret": "after the last digit",
      "caretIgnored": true,
      "separatorTyped": false,
      "signKeys": ["-", "+"],
      "pasteParsed": true,
      "maxDigits": 15,
      "emptyValue": null
    },
    "natural": {
      "digitsAre": "text until a commit",
      "shiftBy": null,
      "writesTextOn": "commit",
      "caret": "the reader's",
      "separatorTyped": true,
      "signKeys": [],
      "pasteParsed": true,
      "maxDigits": null,
      "emptyValue": null
    }
  },
  "range": {
    "min": "min",
    "max": "max",
    "step": "step",
    "largeStep": "largeStep",
    "smallStep": "smallStep",
    "stepFrom": "stepFrom"
  },
  "stepDefaults": {
    "largeStep": "step * 10",
    "smallStep": "step / 10",
    "stepFrom": "min, or 0"
  },
  "format": {
    "style": "currency",
    "currency": "ISO 4217",
    "options": "Intl.NumberFormatOptions",
    "locale": "BCP 47",
    "parserFrom": "formatToParts",
    "fractionDigitsFrom": "the currency's minor units",
    "accountingNegative": "( )"
  },
  "inputMode": {
    "cents": "numeric",
    "negative": "text",
    "fractional": "decimal",
    "integer": "numeric"
  },
  "autocompleteTokens": ["transaction-amount", "transaction-currency"],
  "axes": {
    "size": ["sm", "md", "lg"],
    "variant": ["outline", "subtle", "plain"],
    "entry": ["cents", "natural"],
    "align": ["end", "start"],
    "stepper": ["none", "stacked", "split"],
    "clamp": ["blur", "strict", "none"],
    "currencyDisplay": ["symbol", "narrowSymbol", "code", "name", "none"],
    "formatOn": ["change", "commit"]
  },
  "resolution": {
    "size": ["prop", "field", "defaults", "md"],
    "variant": ["prop", "defaults", "outline"],
    "entry": ["prop", "defaults", "cents"],
    "align": ["prop", "defaults", "end"],
    "stepper": ["prop", "defaults", "none"],
    "clamp": ["prop", "defaults", "blur"],
    "formatOn": ["prop", "defaults", "change"],
    "currency": ["prop", "defaults"],
    "currencyDisplay": ["prop", "defaults", "symbol"],
    "locale": ["prop", "defaults", "runtime"]
  },
  "provides": {
    "currencyFieldDefaults": [
      "align",
      "clamp",
      "currency",
      "currencyDisplay",
      "decrementLabel",
      "entry",
      "formatOn",
      "incrementLabel",
      "locale",
      "size",
      "stepper",
      "variant"
    ]
  },
  "imperative": ["increment", "decrement"],
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "readonly": "data-readonly"
  },
  "stateModel": {
    "value": {
      "controlled": "value",
      "uncontrolled": "defaultValue",
      "request": "onValueChange",
      "reasons": ["keyboard", "pointer", "blur", "programmatic"],
      "carries": ["value", "previous", "minorUnits", "reason", "event"]
    }
  },
  "literals": {
    "--slotted-currency-field-stepper-size": "The stepper column is square and sized from the control's own glyph scale plus its gap, which is arithmetic over tokens rather than a literal; the floor under it is --slotted-target-min, which the theme owns."
  },
  "members": {
    "currencyField": {
      "nativeElement": "input",
      "defaults": {
        "size": "md",
        "variant": "outline",
        "entry": "cents",
        "align": "end",
        "stepper": "none",
        "step": 1,
        "clamp": "blur",
        "formatOn": "change",
        "currencyDisplay": "symbol",
        "wheel": false
      },
      "capabilities": [
        "value",
        "appearance",
        "size",
        "content",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": ["default", "hover", "active", "focus-visible", "disabled", "invalid", "readonly"],
      "parts": ["root", "input", "start", "end", "stepper", "decrement", "increment"]
    }
  },
  "scenarios": {
    "currencyField": [
      "playground",
      "entry",
      "currency",
      "locale",
      "sizes",
      "variants",
      "alignment",
      "range",
      "stepper",
      "adornments",
      "states",
      "content",
      "composition",
      "keyboard"
    ]
  }
}
