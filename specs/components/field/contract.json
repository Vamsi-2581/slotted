{
  "schemaVersion": 5,
  "family": "field",
  "ui": "field",
  "messageFamily": "inline-message",
  "messageTones": {
    "description": "secondary",
    "error": "danger"
  },
  "messageMark": "glyph",
  "messagePlacement": "after",
  "identifiers": ["control", "label", "description", "error"],
  "describedBy": ["description", "error"],
  "wiring": {
    "id": "always",
    "aria-describedby": "merged",
    "aria-invalid": "invalid",
    "aria-required": "required",
    "disabled": "disabled",
    "readonly": "readOnly"
  },
  "necessityWords": {
    "required": "(required)",
    "optional": "(optional)"
  },
  "markHidden": true,
  "containerName": "slotted-field",
  "reflowBreakpoint": "320px",
  "literals": {
    "--slotted-field-label-inline-size": "12rem is a line length rather than a step on a scale: the width at which a label of about twenty characters at the md step sits on one line beside its control. No scale in docs/token-foundation.md holds a line length.",
    "reflowBreakpoint": "320px is literal because CSS forbids a custom property in a container condition, which docs/token-foundation.md rule 4 records."
  },
  "provides": {
    "fieldDefaults": ["size", "labelPlacement", "requiredMark", "necessityWords"]
  },
  "axes": {
    "size": ["sm", "md", "lg"],
    "labelPlacement": ["top", "side"],
    "requiredMark": ["mark", "text", "none"]
  },
  "stateAttributes": {
    "disabled": "data-disabled",
    "invalid": "data-invalid",
    "required": "data-required",
    "readonly": "data-readonly"
  },
  "members": {
    "field": {
      "nativeElement": "div",
      "defaults": {
        "size": "md",
        "labelPlacement": "top",
        "requiredMark": "mark"
      },
      "capabilities": [
        "appearance",
        "size",
        "placement",
        "live",
        "disabled",
        "invalid",
        "required",
        "readOnly",
        "wiring"
      ],
      "states": ["default", "disabled", "invalid", "required", "readonly"],
      "parts": ["root", "label", "mark", "control", "counter"]
    }
  },
  "scenarios": {
    "field": [
      "playground",
      "necessity",
      "placement",
      "sizes",
      "states",
      "messages",
      "counter",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
