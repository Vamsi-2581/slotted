{
  "schemaVersion": 5,
  "family": "inline-message",
  "ui": "inline-message",
  "catalog": {
    "group": "Feedback",
    "summary": "Short status message next to content."
  },
  "axes": {
    "tone": ["accent", "secondary", "info", "success", "warning", "danger"],
    "size": ["sm", "md"],
    "mark": ["glyph", "dot", "none"],
    "live": ["off", "polite", "assertive"]
  },
  "toneGlyphs": {
    "accent": "circle-info",
    "secondary": null,
    "info": "circle-info",
    "success": "circle-check",
    "warning": "triangle-alert",
    "danger": "circle-alert"
  },
  "tonePrefixes": {
    "accent": null,
    "secondary": null,
    "info": null,
    "success": "Success:",
    "warning": "Warning:",
    "danger": "Error:"
  },
  "liveRoles": {
    "off": null,
    "polite": "status",
    "assertive": "alert"
  },
  "actions": {
    "part": "actions, a div after the text holding the answers the message offers",
    "root": "with actions the root is a div, role=group, aria-labelledby the text part; without them a p",
    "live": "a live role moves to the text part when actions are present, so a live region announces the sentence and not the buttons",
    "size": "buttons inside take the message's size (sm → sm, md → md) through the button defaults"
  },
  "stateAttributes": {
    "loading": "data-loading",
    "disabled": "data-disabled"
  },
  "members": {
    "inlineMessage": {
      "nativeElement": "p",
      "defaults": {
        "tone": "secondary",
        "size": "sm",
        "live": "off",
        "mark": "glyph",
        "hideIcon": false,
        "loading": false,
        "reserve": false
      },
      "capabilities": ["appearance", "size", "live", "loading", "disabled"],
      "states": ["default", "loading", "disabled"],
      "parts": ["root", "prefix", "icon", "text", "actions"]
    }
  },
  "scenarios": {
    "inlineMessage": [
      "playground",
      "tones",
      "sizes",
      "pending",
      "wiring",
      "live",
      "reserve",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
