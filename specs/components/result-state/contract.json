{
  "schemaVersion": 5,
  "family": "result-state",
  "ui": "result-state",
  "axes": {
    "status": ["empty", "no-results", "not-found", "error", "forbidden", "offline", "success"],
    "reach": ["inline", "section", "page"],
    "align": ["center", "start"],
    "live": ["off", "polite", "assertive"]
  },
  "statusPaints": {
    "what": "nothing",
    "reason": "A tone glyph standing on an empty surface above a title, with no geometric relation to anything, is the pattern R5 exists to refuse, and RS1 removed it: the region reports what happened in its title, its description and its action, and `status` is the name of the situation rather than a colour or a shape. What a page wants a picture for is its own illustration, which reaches the family through the `media` part."
  },
  "liveRoles": {
    "off": null,
    "polite": "status",
    "assertive": "alert"
  },
  "members": {
    "resultState": {
      "nativeElement": "section",
      "defaults": {
        "status": "empty",
        "reach": "section",
        "align": "center",
        "live": "polite"
      },
      "capabilities": ["appearance", "arrangement", "status", "live"],
      "states": ["default", "focus-visible"],
      "parts": ["root", "media", "content", "title", "description", "actions", "footer"]
    }
  },
  "scenarios": {
    "resultState": [
      "playground",
      "statuses",
      "reach",
      "align",
      "media",
      "actions",
      "live",
      "content",
      "composition",
      "accessibility"
    ]
  }
}
