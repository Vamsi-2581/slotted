{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@slotted/angular/*": ["./packages/angular/*/src/public-api.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "tsBuildInfoFile": "./.turbo/tsconfig.base.tsbuildinfo",
    "useUnknownInCatchVariables": true
  },
  /**
   * The root project has no `include`, so it takes every `.ts` and `.tsx` under
   * the repository — which, once anything has been built, is every emitted
   * `.d.ts` as well. 432 of them: 309 from `react`, 67 from `core`, 56 from
   * `angular`. The program then held two declarations of the same type, the
   * source and the build output, and a build made them differ for one run:
   * `tsc` reported `Story circularly references itself` across every
   * `*.stories.tsx` and the next run passed without a file changing (G6).
   *
   * A build output is not source. The packages that consume one another still
   * resolve to it through `exports`, so the declarations are still checked —
   * once, as the module they are, rather than twice as two root files.
   *
   * `node_modules` is restated because naming `exclude` at all replaces the
   * default that held it.
   */
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/storybook-static/**"
  ],
  "references": []
}
