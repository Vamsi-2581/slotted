{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@slotted/angular#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/specs/components/*/contract.json",
        "$TURBO_ROOT$/packages/styles/src/*/*.tokens.json",
        "$TURBO_ROOT$/apps/docs/examples/**",
        "$TURBO_ROOT$/tools/agent-docs/src/**",
        "$TURBO_ROOT$/tools/agent-docs/bin/**"
      ]
    },
    "@slotted/react#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/specs/components/*/contract.json",
        "$TURBO_ROOT$/packages/styles/src/*/*.tokens.json",
        "$TURBO_ROOT$/apps/docs/examples/**",
        "$TURBO_ROOT$/tools/agent-docs/src/**",
        "$TURBO_ROOT$/tools/agent-docs/bin/**"
      ]
    },
    "@slotted/docs#build": {
      "dependsOn": ["^build", "@slotted/react#build", "@slotted/angular#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["@slotted/theme#build", "@slotted/themes#build"],
      "cache": false,
      "persistent": true
    },
    "verify": {
      "dependsOn": ["^verify"],
      "outputs": ["dist/**", "coverage/**"]
    },
    "@slotted/theme#verify": {
      "dependsOn": ["^verify"],
      "outputs": ["dist/**", "coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/themes/src/default/values.json",
        "$TURBO_ROOT$/packages/styles/src/*/*.tokens.json",
        "$TURBO_ROOT$/specs/components/*/contract.json"
      ]
    },
    "@slotted/docs#verify": {
      "dependsOn": ["^verify", "@slotted/react#verify", "@slotted/angular#verify"],
      "outputs": ["dist/**"]
    }
  }
}
